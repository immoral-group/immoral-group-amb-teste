VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key
RESEND_API_KEY=your-resend-api-key
# Secreta — solo para /api/contact.js (server-side). NUNCA con prefijo VITE_,
# para que Vite no la incluya en el bundle del cliente. Se copia desde
# Supabase Dashboard → Project Settings → API → service_role key.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# reCAPTCHA v3 — mismo par de claves en las 4 webs del grupo (Google admite
# varios dominios por site key). La secret key solo vive aquí (server-side,
# nunca con prefijo VITE_); el site key sí es público y se repite en el
# .env.example de cada web como VITE_RECAPTCHA_SITE_KEY / NEXT_PUBLIC_RECAPTCHA_SITE_KEY.
VITE_RECAPTCHA_SITE_KEY=your-recaptcha-v3-site-key
RECAPTCHA_SECRET_KEY=your-recaptcha-v3-secret-key
# Opcional — Deploy Hook de Vercel para publicar cambios de /casos-admin al instante.
# Ver supabase/README.md, paso 13.
VITE_DEPLOY_HOOK_URL=
