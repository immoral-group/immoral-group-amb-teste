{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/qr/:code",
      "destination": "/api/qr?code=:code"
    }
  ],
  "redirects": [
    {
      "source": "/manifesto",
      "destination": "/nuestra-historia",
      "statusCode": 301
    },
    {
      "source": "/manifesto.html",
      "destination": "/nuestra-historia",
      "statusCode": 301
    }
  ]
}
